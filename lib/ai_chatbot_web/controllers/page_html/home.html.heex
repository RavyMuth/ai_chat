<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>AI Chatbot</title>

    <script src="https://cdn.tailwindcss.com">
    </script>
  </head>

  <body class="bg-zinc-950 min-h-screen overflow-hidden">
    
<!-- ========================= -->
  <!-- MAIN APP -->
  <!-- ========================= -->

    <div class="max-w-5xl mx-auto h-screen flex flex-col">
      
<!-- ========================= -->
    <!-- HEADER -->
    <!-- ========================= -->

      <div class="flex items-center justify-between p-5 border-b border-white/10">
        <div>
          <h1 class="text-2xl font-bold text-white">
            🤖 Elixir AI Chatbot
          </h1>

          <p class="text-sm text-white/40">
            Powered by Groq AI
          </p>
        </div>

        <div class="flex gap-3">
          
<!-- History -->
          <button
            onclick="toggleSidebar()"
            class="bg-zinc-800 hover:bg-zinc-700 text-white px-4 py-2 rounded-xl transition"
          >
            📚 History
          </button>
          
<!-- New Chat -->
          <button
            onclick="newChat()"
            class="bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded-xl transition"
          >
            ✨ New Chat
          </button>
        </div>
      </div>
      
<!-- ========================= -->
    <!-- CHAT BOX -->
    <!-- ========================= -->

      <div
        id="chat-box"
        class="flex-1 overflow-y-auto p-5 space-y-4"
      >
      </div>
      
<!-- ========================= -->
    <!-- TYPING -->
    <!-- ========================= -->

      <div
        id="typing"
        class="hidden px-5 pb-2 text-sm text-white/40"
      >
        AI is typing...
      </div>
      
<!-- ========================= -->
    <!-- INPUT -->
    <!-- ========================= -->

      <div class="p-5 border-t border-white/10">
        <div class="flex gap-3">
          <input
            id="message"
            type="text"
            placeholder="Type your message..."
            class="flex-1 bg-zinc-900 border border-white/10 text-white rounded-2xl px-5 py-4 outline-none focus:border-blue-500"
            onkeydown="if(event.key==='Enter'){sendMessage()}"
          />

          <button
            onclick="sendMessage()"
            class="bg-blue-600 hover:bg-blue-700 text-white px-8 rounded-2xl transition"
          >
            Send
          </button>
        </div>
      </div>
    </div>
    
<!-- ========================= -->
  <!-- HISTORY SIDEBAR -->
  <!-- ========================= -->

    <div
      id="history-sidebar"
      class="fixed top-0 right-0 w-80 h-full bg-zinc-900 border-l border-white/10 transform translate-x-full transition-transform duration-300 z-50 flex flex-col"
    >
      
<!-- Header -->
      <div class="p-5 border-b border-white/10 flex items-center justify-between">
        <div>
          <h2 class="text-xl font-bold text-white">
            📜 Chat History
          </h2>

          <p class="text-sm text-white/40">
            Saved conversations
          </p>
        </div>

        <button
          onclick="toggleSidebar()"
          class="text-white/40 hover:text-white text-xl"
        >
          ✕
        </button>
      </div>
      
<!-- History List -->
      <div
        id="history-list"
        class="flex-1 overflow-y-auto p-3 space-y-3"
      >
      </div>
    </div>
    
<!-- ========================= -->
  <!-- SCRIPT -->
  <!-- ========================= -->

    <script>
      // =========================
      // STATE
      // =========================

      let currentChat = []

      // =========================
      // TOGGLE SIDEBAR
      // =========================

      function toggleSidebar() {

        const sidebar =
          document.getElementById("history-sidebar")

        sidebar.classList.toggle("translate-x-full")
      }

      // =========================
      // NEW CHAT
      // =========================

      function newChat() {

        currentChat = []

        document.getElementById("chat-box").innerHTML = ""
      }

      // =========================
      // ADD MESSAGE
      // =========================

      function addMessage(text, type) {

        const chatBox =
          document.getElementById("chat-box")

        const wrapper =
          document.createElement("div")

        wrapper.className =
          type === "user"
            ? "flex justify-end"
            : "flex justify-start"

        const bubble =
          document.createElement("div")

        bubble.className =
          type === "user"
            ? "bg-blue-600 text-white px-5 py-3 rounded-2xl max-w-[80%] whitespace-pre-wrap"
            : "bg-zinc-800 text-white px-5 py-3 rounded-2xl max-w-[80%] whitespace-pre-wrap"

        bubble.innerText = text

        wrapper.appendChild(bubble)

        chatBox.appendChild(wrapper)

        chatBox.scrollTop =
          chatBox.scrollHeight

        currentChat.push({
          text,
          type
        })
      }

      // =========================
      // SEND MESSAGE
      // =========================

      async function sendMessage() {

        const input =
          document.getElementById("message")

        const text =
          input.value.trim()

        if (!text) return

        // show user message
        addMessage(text, "user")

        input.value = ""

        // typing
        document
          .getElementById("typing")
          .classList.remove("hidden")

        try {

          const response =
            await fetch("/api/chat", {
              method: "POST",
              headers: {
                "Content-Type": "application/json"
              },
              body: JSON.stringify({
                message: text
              })
            })

          const data =
            await response.json()

          // hide typing
          document
            .getElementById("typing")
            .classList.add("hidden")

          if (!response.ok) {

            addMessage(data.error || "Groq API error", "ai")

          } else if (data.reply) {

            addMessage(data.reply, "ai")

          } else {

            addMessage("No response from AI", "ai")
          }

        } catch (error) {

          document
            .getElementById("typing")
            .classList.add("hidden")

          addMessage("Server connection error", "ai")

          console.error(error)
        }
      }

      // =========================
      // SAVE CONVERSATION
      // =========================

      function saveConversation() {

        if (currentChat.length === 0) {
          alert("No chat to save")
          return
        }

        const title =
          prompt("Enter conversation title:")

        if (!title) return

        const history =
          JSON.parse(
            localStorage.getItem("chat-conversations")
          ) || []

        const conversation = {
          id: Date.now(),
          title,
          createdAt: new Date().toLocaleString(),
          messages: currentChat
        }

        history.unshift(conversation)

        localStorage.setItem(
          "chat-conversations",
          JSON.stringify(history)
        )

        renderHistory()

        alert("Conversation saved!")
      }

      // =========================
      // RENDER HISTORY
      // =========================

      function renderHistory() {

        const historyList =
          document.getElementById("history-list")

        const history =
          JSON.parse(
            localStorage.getItem("chat-conversations")
          ) || []

        historyList.innerHTML = ""

        if (history.length === 0) {

          historyList.innerHTML = `
            <div class="text-center text-white/40 mt-10">
              No saved chats
            </div>
          `

          return
        }

        history.forEach(chat => {

          const card =
            document.createElement("div")

          card.className =
            "bg-zinc-800 border border-white/10 rounded-2xl p-4"

          card.innerHTML = `
            <div class="space-y-2">

              <div>
                <h3 class="text-white font-semibold line-clamp-1">
                  ${chat.title}
                </h3>

                <p class="text-xs text-white/40">
                  ${chat.createdAt}
                </p>
              </div>

              <div class="flex gap-2 pt-2">

                <button
                  onclick="loadConversation(${chat.id})"
                  class="flex-1 bg-blue-600 hover:bg-blue-700 text-white py-2 rounded-xl text-sm transition"
                >
                  Open
                </button>

                <button
                  onclick="deleteConversation(${chat.id})"
                  class="bg-red-500 hover:bg-red-600 text-white px-3 rounded-xl text-sm transition"
                >
                  Delete
                </button>

              </div>

            </div>
          `

          historyList.appendChild(card)
        })
      }

      // =========================
      // LOAD CONVERSATION
      // =========================

      function loadConversation(id) {

        const history =
          JSON.parse(
            localStorage.getItem("chat-conversations")
          ) || []

        const conversation =
          history.find(c => c.id === id)

        if (!conversation) return

        currentChat =
          conversation.messages

        const chatBox =
          document.getElementById("chat-box")

        chatBox.innerHTML = ""

        currentChat.forEach(msg => {

          const wrapper =
            document.createElement("div")

          wrapper.className =
            msg.type === "user"
              ? "flex justify-end"
              : "flex justify-start"

          const bubble =
            document.createElement("div")

          bubble.className =
            msg.type === "user"
              ? "bg-blue-600 text-white px-5 py-3 rounded-2xl max-w-[80%] whitespace-pre-wrap"
              : "bg-zinc-800 text-white px-5 py-3 rounded-2xl max-w-[80%] whitespace-pre-wrap"

          bubble.innerText = msg.text

          wrapper.appendChild(bubble)

          chatBox.appendChild(wrapper)
        })

        chatBox.scrollTop =
          chatBox.scrollHeight

        toggleSidebar()
      }

      // =========================
      // DELETE CONVERSATION
      // =========================

      function deleteConversation(id) {

        let history =
          JSON.parse(
            localStorage.getItem("chat-conversations")
          ) || []

        history =
          history.filter(c => c.id !== id)

        localStorage.setItem(
          "chat-conversations",
          JSON.stringify(history)
        )

        renderHistory()
      }

      // =========================
      // AUTO LOAD HISTORY
      // =========================

      window.onload = () => {
        renderHistory()
      }
    </script>
    
<!-- ========================= -->
  <!-- SAVE FLOAT BUTTON -->
  <!-- ========================= -->

    <button
      onclick="saveConversation()"
      class="fixed bottom-5 right-5 bg-green-600 hover:bg-green-700 text-white px-5 py-3 rounded-2xl shadow-2xl transition"
    >
      💾 Save Chat
    </button>
  </body>
</html>
